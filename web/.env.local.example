# Copy to web/.env.local. Everything here is optional.
# RollWatch API base (default http://localhost:8000). Sign-in by WhatsApp code goes through it.
# NEXT_PUBLIC_API_BASE=http://localhost:8000
# WhatsApp bot number, digits only with country code (e.g. 9198xxxxxxxx). Unset = no WhatsApp links.
# NEXT_PUBLIC_WA_NUMBER=
