# Copy to .env (git-ignored) and fill in. Every key is optional: without one, that feature falls back to templates.

# Claude: claim splitting, screenshot reading, answer phrasing (console.anthropic.com)
ANTHROPIC_API_KEY=

# Gemini: fallback if Claude fails (aistudio.google.com)
GEMINI_API_KEY=

# Sarvam: Hindi voice in/out for the bot (dashboard.sarvam.ai)
SARVAM_API_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Leave at 0 for live AI. 1 = stage mode: only cached LLM answers, never a live call.
DEMO_MODE=0
