# Copy to .env (git-ignored) and fill in. Every key is optional: without one, that feature falls back to templates.
# Users can also bring their own key per request: headers X-Gemini-Key and X-ElevenLabs-Key (never stored or logged).

# Gemini (gemini-3.5-flash, free tier): claim splitting, screenshot reading, answer phrasing (aistudio.google.com)
GEMINI_API_KEY=

# ElevenLabs: voice in (scribe_v1) and out (eleven_multilingual_v2) for web and bot (elevenlabs.io)
ELEVENLABS_API_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Leave at 0 for live AI. 1 = stage mode: only cached LLM answers, never a live call.
DEMO_MODE=0

# WhatsApp sign-in. AUTH_SECRET signs login tokens (random hex, 32+ bytes; if empty, tokens end on restart).
AUTH_SECRET=
# Shared between the API and the wa/ worker (any long random string).
WA_WORKER_SECRET=
# Where the wa/ worker reaches the API (worker side only).
API_BASE=http://localhost:8000
# Supabase (server only). Without the service-role key, account data lives in memory.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
