{
  "$defs": {
    "GuardResult": {
      "properties": {
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "blocked_terms": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Blocked Terms",
          "type": "array"
        },
        "rewritten": {
          "default": false,
          "title": "Rewritten",
          "type": "boolean"
        }
      },
      "required": [
        "passed"
      ],
      "title": "GuardResult",
      "type": "object"
    },
    "SearchMatch": {
      "properties": {
        "voter_id": {
          "title": "Voter Id",
          "type": "string"
        },
        "name_dev": {
          "title": "Name Dev",
          "type": "string"
        },
        "name_lat": {
          "title": "Name Lat",
          "type": "string"
        },
        "booth_id": {
          "title": "Booth Id",
          "type": "string"
        },
        "status_v2": {
          "enum": [
            "present",
            "modified",
            "not_in_new_list",
            "not_found"
          ],
          "title": "Status V2",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "voter_id",
        "name_dev",
        "name_lat",
        "booth_id",
        "status_v2",
        "score"
      ],
      "title": "SearchMatch",
      "type": "object"
    }
  },
  "properties": {
    "lang": {
      "enum": [
        "hi",
        "en",
        "pa"
      ],
      "title": "Lang",
      "type": "string"
    },
    "transcript": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transcript"
    },
    "answer_text": {
      "title": "Answer Text",
      "type": "string"
    },
    "answer_audio_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Answer Audio Url"
    },
    "match": {
      "anyOf": [
        {
          "$ref": "#/$defs/SearchMatch"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "enum": [
        "present",
        "modified",
        "not_in_new_list",
        "not_found"
      ],
      "title": "Status",
      "type": "string"
    },
    "reason_category": {
      "enum": [
        "shifted",
        "death_registered",
        "duplicate_cleanup",
        "boundary_change",
        "unexplained",
        "none"
      ],
      "title": "Reason Category",
      "type": "string"
    },
    "next_steps": {
      "items": {
        "type": "string"
      },
      "title": "Next Steps",
      "type": "array"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "guard": {
      "$ref": "#/$defs/GuardResult"
    }
  },
  "required": [
    "lang",
    "answer_text",
    "status",
    "reason_category",
    "next_steps",
    "confidence",
    "guard"
  ],
  "title": "CitizenAnswer",
  "type": "object"
}